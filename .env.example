# ==============================================================================
# MISSING CALL ASSISTANT - PRODUCTION CONFIGURATION
# ==============================================================================

# --- Server & Runtime (Private Server Variables) ---
HOST=0.0.0.0
PORT=4000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_signing_key_production_2026
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Android Ingest Webhook (Private Server Variable) ---
WEBHOOK_SECRET=your_android_webhook_hmac_secret_key_v1

# --- Meta WhatsApp Cloud API (Private Server Variables) ---
META_APP_SECRET=your_meta_app_secret_hex
META_VERIFY_TOKEN=your_meta_webhook_verify_token

# --- Razorpay Payment & Subscription Gateway ---
# PUBLIC VARIABLE (Safe for client initialization / checkout if required)
RAZORPAY_KEY_ID=rzp_live_your_public_key_id

# PRIVATE SERVER-ONLY VARIABLES (NEVER EXPOSE TO CLIENT / BROWSER / APK)
RAZORPAY_KEY_SECRET=your_private_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_private_razorpay_webhook_secret
RAZORPAY_PLAN_ID=plan_your_monthly_autopay_plan_id
