# ==============================================================================
# MissCall Assistant - Environment Variables Configuration
# ==============================================================================

# 1. Razorpay Payment Gateway Credentials (API Keys)
# Generate from: https://dashboard.razorpay.com/#/app/keys
# Use 'rzp_test_...' for local development & testing, 'rzp_live_...' for production.
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 2. Razorpay Monthly Subscription Plan ID (₹100 / month)
# Create in Razorpay Dashboard > Subscriptions > Plans > Create Plan
# Amount: ₹100.00 (10000 paise), Billing Frequency: Monthly
RAZORPAY_PLAN_ID=plan_your_created_plan_id_here

# 3. Razorpay Webhook Secret
# Set in Razorpay Dashboard > Settings > Webhooks > Add Webhook
# Webhook URL: https://web-dashboard-eight-mu.vercel.app/api/razorpay/webhook
# Secret: choose any strong random string (e.g. openssl rand -hex 20)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 4. Device Anonymous Authentication Secret (JWT)
# Used to cryptographically sign anonymous device session tokens without passwords
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_characters

# 5. Database Storage (Optional: defaults to persistent serverless store / .data/devices_db.json)
# If using Supabase (PostgreSQL):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# If using Vercel KV / Upstash Redis:
# KV_REST_API_URL=https://your-kv-instance.upstash.io
# KV_REST_API_TOKEN=your_kv_rest_token

# 6. Admin Portal Master Access
ADMIN_OWNER_EMAIL=ssdd747346@gmail.com
ADMIN_PASSWORD=your_admin_portal_password
ADMIN_SESSION_SECRET=admin_jwt_super_secret_session_key_2026
